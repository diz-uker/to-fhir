<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ig-codegen</ToolCommandName>
    <PackageId>io.github.diz-uker.ig-codegen</PackageId>
    <Description>A code generator that turns FHIR IG package.json manifests into strongly-typed C# (and Java) constants for CodeSystem URLs, concept enums, profiles, extensions, and NamingSystems.</Description>
    <PackageTags>FHIR;HL7;codegen;dotnet-tool</PackageTags>
    <Optimize>true</Optimize>
    <!-- Dotnet tool — internal types don't need exhaustive XML doc comments. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Scanner/generator library API — packed separately (io.github.diz-uker.ig-codegen-core)
         since PackAsTool packages ship a tools/ payload only, with no lib/ assets a consumer could
         add as a PackageReference to call IgPackageScanner/CSharpConstantsGenerator directly. -->
    <ProjectReference Include="../IgCodegen.Core/IgCodegen.Core.csproj" />
  </ItemGroup>
</Project>
