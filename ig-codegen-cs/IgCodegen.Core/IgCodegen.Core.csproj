<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageId>DizUker.IgCodegen.Core</PackageId>
    <Description>Library API behind the ig-codegen dotnet tool: scans a restored FHIR IG package directory (IgPackageScanner) and renders it as C# constants (CSharpConstantsGenerator). Reference this instead of the ig-codegen tool package when a consumer needs to drive generation itself, e.g. against an IG that isn't published to a FHIR package registry.</Description>
    <PackageTags>FHIR;HL7;codegen</PackageTags>
    <!-- Public API types have no hand-written XML doc comments beyond what's generated. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
